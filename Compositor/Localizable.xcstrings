    "Add layer mask revealing the selection (Option-click to hide it)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加显示选区的图层蒙版（按住 Option 点按可改为隐藏）"
          }
