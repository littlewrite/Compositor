{
  "sourceLanguage" : "en",
  "strings" : {
    " · Handles to resize · Circle to rotate" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · 拖移控制柄以调整大小 · 拖动圆圈以旋转"
          }
        }
      }
    },
    "%@ color" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@颜色"
          }
        }
      }
    },
    "%@ effect" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@效果"
          }
        }
      }
    },
    "%@ is assigned to both %@ and %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 同时分配给了 %@ 和 %@。"
          }
        }
      }
    },
    "%@ is reserved by macOS." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 由 macOS 保留。"
          }
        }
      }
    },
    "%@ layers have nothing to export" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 个图层没有可导出的内容"
          }
        }
      }
    },
    "%@ of these files already exist in “%@”. Replace them?" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 个此类文件已存在于“%@”中。要替换它们吗？"
          }
        }
      }
    },
    "%@ over blemishes to heal · %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@在瑕疵上拖移以修复 · %@"
          }
        }
      }
    },
    "%@ to %@ · %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以%@ · %@"
          }
        }
      }
    },
    "%@ to clone · Drag the crosshair, or Option-tap, to copy from elsewhere · %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以仿制 · 拖移十字准线，或按住 Option 点按，可从其他位置拷贝 · %@"
          }
        }
      }
    },
    "%@ where to copy from · %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以选择拷贝来源 · %@"
          }
        }
      }
    },
    "%@ · Drag inside to move it · Two fingers move and zoom" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · 在内部拖移以移动 · 双指移动和缩放"
          }
        }
      }
    },
    "%@, or move one of its ends · %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，或移动其一个端点 · %@"
          }
        }
      }
    },
    "3 by 3 Average" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 × 3 平均"
          }
        }
      }
    },
    "5 by 5 Average" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 × 5 平均"
          }
        }
      }
    },
    "A layer with no visible pixels, such as an adjustment layer, isn’t saved as a PNG." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有任何可见像素的图层（例如调整图层）不会保存为 PNG。"
          }
        }
      }
    },
    "A little stronger than Version 1. The sliders below still fall well short of the current look." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比版本 1 略强。下方滑块仍远未达到当前效果。"
          }
        }
      }
    },
    "A new version of %@ is available!" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 有新版本可用！"
          }
        }
      }
    },
    "A subdivision every %@ pixels." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每 %@ 像素一个细分。"
          }
        }
      }
    },
    "A whole number from 1 to %@ px." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入 1 到 %@ 之间的整数像素值。"
