      }
    },
    "Adds a layer effect." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加图层效果。"
          }
        }
      }
    },
    "Adds film grain, strongest in the middle tones." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加胶片颗粒，在中间调最强。"
          }
        }
      }
    },
    "Adds green or magenta to the darkest tones." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为最暗的色调添加绿色或洋红。"
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿较大的形状增加或柔化对比度。"
          }
        }
      }
    },
    "Adds or softens sharpening." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "增加或减弱锐化。"
          }
        }
      }
    },
    "Adds or softens small detail." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "增加或柔化细小细节。"
          }
        }
      }
    },
    "Adjust every color outside this range instead of the colors in it" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整此范围之外的所有颜色，而不是范围内的颜色"
          }
        }
      }
    },
    "Adjustment input" : {
      "localizations" : {
        "zh-Hans" : {
