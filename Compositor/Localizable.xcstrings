    "Bake and Delete" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烘焙并删除"
          }
        }
      }
    },
    "Bake keeps the current masked appearance in the dependent layers’ pixels. Remove Links reveals their pixels. You can undo either choice." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“烘焙”会将当前蒙版后的外观保留到相关图层的像素中；“移除链接”会显示它们的像素。两种选择都可撤销。"
          }
        }
      }
    },
    "Balance" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平衡"
          }
        }
      }
    },
    "Balance the average color of the picture" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平衡画面的平均颜色"
          }
        }
      }
    },
    "Based On" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于"
          }
        }
      }
    },
    "Basic is quick; Advanced refines the mask against the layer's own detail, for hair and fur" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“基本”速度快；“高级”会依据图层自身的细节细化蒙版，适合毛发。"
          }
        }
      }
    },
