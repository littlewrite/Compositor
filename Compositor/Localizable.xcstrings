    "Add layer mask (Option-click for a black mask)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加图层蒙版（按住 Option 点按可添加黑色蒙版）"
